# Copia in .env (non va mai nel repository) e compila i valori.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=genera-una-chiave-lunga-e-casuale
DJANGO_ALLOWED_HOSTS=fatture.example.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://fatture.example.it
DATABASE_URL=postgres://utente:password@localhost:5432/fatturazione
# Percorso dell'area amministrativa Django (meglio non prevedibile).
DJANGO_ADMIN_URL=gestione-riservata/
